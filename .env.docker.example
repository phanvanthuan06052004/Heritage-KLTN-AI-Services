# ============================================================
# Heritage AI Services — Docker Compose environment
# cp .env.docker.example .env.docker
# ============================================================

# --- PostgreSQL (Docker service: postgres) ---
DATABASE_URL=postgresql+asyncpg://heritage_ai:heritage_ai_secret@postgres:5432/heritage_ai
POSTGRES_USER=heritage_ai
POSTGRES_PASSWORD=heritage_ai_secret
POSTGRES_DB=heritage_ai

# --- Auth ---
SECRET_KEY=change-me-generate-with-openssl-rand-hex-64

# --- Default Admin ---
DEFAULT_ADMIN_EMAIL=admin@heritage-ai.local
DEFAULT_ADMIN_PASSWORD=Heritage@Admin2024!

# --- Heritage Bridge token (share this with Heritage-LastDance-BE docker env) ---
HERITAGE_SERVICE_TOKEN=change-me-generate-with-openssl-rand-hex-32

# --- Heritage NestJS Backend ---
HERITAGE_BE_URL=http://host.docker.internal:3000

# --- MinIO (Docker service: minio) ---
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=heritage-ai-files
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_HOURS=24

# --- Redis (Docker service: redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
WORKER_MAX_JOBS=3
WORKER_JOB_TIMEOUT=600

# --- CORS ---
CORS_ORIGINS=*

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:5055
