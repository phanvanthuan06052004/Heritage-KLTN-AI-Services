# ============================================================
# Heritage AI Services — Local development environment
# cp .env.example .env
# Requires: PostgreSQL (pgvector), Redis, MinIO running on localhost
# ============================================================

# --- PostgreSQL (pgvector required) ---
# Database is separate from Heritage-LastDance-BE (NestJS uses MySQL, AI service uses PostgreSQL)
DATABASE_URL=postgresql+asyncpg://heritage_ai:heritage_ai_secret@localhost:5432/heritage_ai

# Docker compose variables (used in docker-compose.yml)
POSTGRES_USER=heritage_ai
POSTGRES_PASSWORD=heritage_ai_secret
POSTGRES_DB=heritage_ai

# --- Auth (internal Arkon portal JWT) ---
SECRET_KEY=change-me-to-a-very-long-random-secret-string-for-heritage-ai

# --- Default Admin Account (for the Arkon portal UI) ---
DEFAULT_ADMIN_EMAIL=admin@heritage-ai.local
DEFAULT_ADMIN_PASSWORD=Heritage@Admin2024!

# --- Heritage Bridge (service-to-service auth) ---
# This token is shared with Heritage-LastDance-BE (NestJS).
# Set to a long random string. The NestJS service sends:
#   Authorization: Bearer <HERITAGE_SERVICE_TOKEN>
# Generate with: openssl rand -hex 32
HERITAGE_SERVICE_TOKEN=change-me-generate-with-openssl-rand-hex-32

# --- Heritage NestJS Backend URL ---
HERITAGE_BE_URL=http://localhost:3000

# --- MinIO (file/document storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=heritage-ai-files
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_HOURS=24

# --- Redis (async job queue for ingestion workers) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
WORKER_MAX_JOBS=3
WORKER_JOB_TIMEOUT=600

# --- CORS (allow Heritage-LastDance-BE and FE to call this service) ---
# In development: allow all
CORS_ORIGINS=*
# In production, set explicitly:
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-fe-domain.com

# --- Frontend (Arkon portal UI) ---
NEXT_PUBLIC_API_URL=http://localhost:5055
